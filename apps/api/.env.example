NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=

# Obtain a Pyth Lazer API key from https://pyth.network/ / https://app.pyth.com/
PYTH_API_KEY=
PYTH_SYMBOL=Metal.XAU/USD
PYTH_CHANNEL=fixed_rate@1000ms
PYTH_STALE_AFTER_MS=60000
PYTH_RECONNECT_BASE_MS=1000
PYTH_RECONNECT_MAX_MS=30000

# Collector behaviour
COLLECTOR_ENABLED=true
CANDLE_TIMEFRAMES=M1,M5,M15,H1,H4,D1
